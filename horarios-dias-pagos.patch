+    <span class="input-label">{{ __('Horarios de atención') }}</span>
+    <p class="mt-1 text-sm text-gray-500">
+        Activá los días que abrís y elegí desde y hasta qué hora. Si cerrás al mediodía, agregá un segundo turno.
+    </p>
+
