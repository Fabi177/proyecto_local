+    private function decodificarJsonHorarios(Request $request): void
+    {
+        foreach (['horarios_config', 'dias_cierre'] as $campo) {
+            $crudo = $request->input($campo);
+
+            if (is_string($crudo) && $crudo !== '') {
+                $decodificado = json_decode($crudo, true);
